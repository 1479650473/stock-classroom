{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri/v2/core/tauri-config-schema/schema.json",
  "productName": "股票教室",
  "mainBinaryName": "StockClassroom",
  "version": "5.2.0",
  "identifier": "com.stockclassroom.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "股票教室",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 640,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "resizable": true,
        "center": true,
        "visible": false,
        "focus": true
      },
      {
        "label": "splash",
        "title": "股票教室",
        "url": "splash.html",
        "width": 420,
        "height": 420,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "股票教室",
    "category": "Finance",
    "shortDescription": "A股量化工作台",
    "longDescription": "股票教室：数据更新、因子挖掘、策略回测、模拟交易与 AI 操盘手一体的本地量化工作台。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../package/dist/stock-api.exe": "stock-api.exe",
      "../../backend/configs/settings.example.json": "backend/configs/settings.example.json"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "languages": [
          "SimpChinese"
        ],
        "installMode": "currentUser",
        "compression": "lzma",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
